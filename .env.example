# Copy to .env and fill in values used by core/application.yml
# Integration tokens can also be passed per-request from the UI.

# Chat / investigate (Groq primary, DeepSeek transient-failure fallback)
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# Active chat provider (deepseek | groq | openrouter | ollama)
ANDROMEDIA_CHAT_PROVIDER=deepseek

# Embeddings (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Andromedia
OPENROUTER_CHAT_MODEL=anthropic/claude-3-5-haiku

# Hosted trial mode (set on trial / App Runner deployment; local dev stays false)
ANDRO_TRIAL_ENABLED=false
ANDRO_TRIAL_CHAT_MODEL=anthropic/claude-3-5-haiku
ANDRO_CORS_ORIGINS=https://andro-app.vercel.app
SPRING_PROFILES_ACTIVE=trial
ANDRO_TRIAL_REQUIRE_CLERK_JWT=true
ANDRO_CLERK_JWKS_URL=
ANDRO_CLERK_ISSUER=

# Postgres credential vault (App Runner + RDS)
# Local: docker compose postgres on localhost — see andromedia/.env.example
# Production App Runner: set these on the service (values in Secrets Manager andro/rds/master)
ANDROMEDIA_CREDENTIALS_POSTGRES_ENABLED=true
ANDROMEDIA_DATABASE_URL=jdbc:postgresql://localhost:5432/andromedia
ANDROMEDIA_DATABASE_USER=andromedia
ANDROMEDIA_DATABASE_PASSWORD=andromedia
# Base64 32-byte AES key — production: Secrets Manager andro/credentials-encryption-key
# ANDROMEDIA_CREDENTIALS_ENCRYPTION_KEY=
ANDROMEDIA_CREDENTIALS_ALLOW_EPHEMERAL_KEY=true

# Optional server-side defaults (UI can still send credentials in requests)
SLACK_BOT_TOKEN=
NOTION_API_KEY=
