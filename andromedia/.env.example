# Copy to .env and adjust as needed.
# Used by docker compose and local mvn spring-boot:run (localhost Postgres).
# Production App Runner + RDS: see docs/aws-apprunner-rds-vercel.md
# Secrets live in AWS Secrets Manager (andro/rds/master, andro/credentials-encryption-key).

# --- Postgres credential vault ---
ANDROMEDIA_CREDENTIALS_POSTGRES_ENABLED=true
ANDROMEDIA_DATABASE_NAME=andromedia
ANDROMEDIA_DATABASE_USER=andromedia
ANDROMEDIA_DATABASE_PASSWORD=andromedia

# Local Maven / host process (Postgres published on localhost:5432):
ANDROMEDIA_DATABASE_URL=jdbc:postgresql://localhost:5432/andromedia

# App Runner production example (do not commit real passwords):
# ANDROMEDIA_DATABASE_URL=jdbc:postgresql://andro-credits-rds.cvuwcw0sqe4r.ap-south-1.rds.amazonaws.com:5432/andromedia
# ANDROMEDIA_DATABASE_USER=androadmin
# ANDROMEDIA_DATABASE_PASSWORD=<from Secrets Manager andro/rds/master>
# ANDROMEDIA_CREDENTIALS_ALLOW_EPHEMERAL_KEY=false

# Optional durable AES key (base64 32 bytes). Default exists in application.yml for local/dev.
# Production: use Secrets Manager andro/credentials-encryption-key
# ANDROMEDIA_CREDENTIALS_ENCRYPTION_KEY=

# --- Chat / investigate ---
# Set ANDROMEDIA_CHAT_PROVIDER to whichever provider you actually give a key to.
# If the selected provider has no key, /investigate answers "answer synthesis is
# unavailable" for EVERY question — including the deterministic ones, because the
# LLM classifier that routes to them never runs. That failure looks like a broken
# product rather than a config mistake.
ANDROMEDIA_CHAT_PROVIDER=deepseek
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Andromedia
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional local Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
# OLLAMA_API_KEY=

# --- Integration defaults (UI can still override per request) ---
SLACK_BOT_TOKEN=
NOTION_API_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
LINEAR_API_KEY=

# Legacy global Zoho fallback — superseded by ANDROMEDIA_OAUTH_ZOHO_CLIENT_ID/SECRET below.
# Zoho is now OAuth-login-only (users click "Login with Zoho"), so these are unused unless
# ZohoIngestionProperties' env-var fallback path is still relied on somewhere.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_REGION=com

# Google OAuth app (shared across Google Chat / Gmail / Docs — one Cloud
# Console app, incremental scopes). Redirect URI registered in that app:
# http://localhost:8083/api/v1/oauth/google_chat/callback
ANDROMEDIA_OAUTH_GOOGLE_CLIENT_ID=
ANDROMEDIA_OAUTH_GOOGLE_CLIENT_SECRET=

# Linear OAuth app. Redirect URI to register:
# http://localhost:8083/api/v1/oauth/linear/callback
ANDROMEDIA_OAUTH_LINEAR_CLIENT_ID=
ANDROMEDIA_OAUTH_LINEAR_CLIENT_SECRET=

# Zoho OAuth app (Server-based Application, not a Self Client — users log in via redirect
# instead of pasting a grant token). Redirect URI to register:
# http://localhost:8083/api/v1/oauth/zoho/callback
ANDROMEDIA_OAUTH_ZOHO_CLIENT_ID=
ANDROMEDIA_OAUTH_ZOHO_CLIENT_SECRET=

# Jira OAuth app (Atlassian OAuth 2.0 3LO — Jira Cloud only, not Server/Data Center). Redirect
# URI to register: http://localhost:8083/api/v1/oauth/jira/callback
ANDROMEDIA_OAUTH_JIRA_CLIENT_ID=
ANDROMEDIA_OAUTH_JIRA_CLIENT_SECRET=

# Optional Slack deal alerts
ANDRO_ALERTS_SLACK_BOT_TOKEN=
ANDRO_ALERTS_SLACK_CHANNEL=

# Local trial stays off
ANDRO_TRIAL_ENABLED=false
ANDRO_CORS_ORIGINS=http://localhost:3000
