# Same Clerk application as the landing app when possible.
VITE_CLERK_PUBLISHABLE_KEY=

# Hosted trial API (Trial mode). Packaged AppImage should bake the App Runner URL:
VITE_ANDROMEDIA_API_URL=http://localhost:8083
# VITE_ANDROMEDIA_API_URL=https://tuuf7zapih.ap-south-1.awsapprunner.com

# Optional override for Local Pro (defaults to http://localhost:8083):
# VITE_LOCAL_ANDROMEDIA_API_URL=http://localhost:8083

# Browser auth surface for Cursor-style Sign in / Sign up (opens system browser):
VITE_AUTH_WEB_URL=https://andro-app.vercel.app

# Desktop deep link: andro://auth/callback?ticket=… (registered by Electron / AppImage).
# Landing mints the ticket after web sign-in — Clerk dashboard does not need andro:// allowlisted.
# Keep Clerk allowed origins for the landing site (https://andro-app.vercel.app).

# Connector relay for ChatGPT / Claude in the browser (Electron main process env,
# not VITE_ — read by electron/connector.cjs). Defaults to the hosted relay.
# ANDRO_RELAY_URL=https://wykugmbu2n.us-east-1.awsapprunner.com
# ANDRO_LOCAL_API_URL=http://localhost:8083
